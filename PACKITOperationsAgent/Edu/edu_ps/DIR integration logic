  METHOD init_document_links."redefinition
    DATA: lv_cp     TYPE xfeld,
          ls_outtab TYPE z0mp_s_dms_ps_ui_grid,
          ls_pnodid TYPE ppet_pnodid_li.

    BREAK-POINT ID z0mp_all.
    BREAK-POINT ID z0mp_ps_dms.

    gv_object_key = iv_object_key.
    CLEAR: gt_outtab.
*1 step one: get all documents linked to this packspec/workstep
*    IF gv_dokar = z0mp_if_packspec_constants=>gc_dokar_packspec.  "214
*      lv_cp = abap_true. "search with key+wildcard  "214
*    ENDIF.  "214
    IF gv_dokar = z0mp_if_packspec_constants=>gc_dokar_workstep.
      "convert guid of workstep to id
      ls_pnodid-pnguid = iv_object_key.
      ls_pnodid-applobj_type = /scwm/cl_ppelipak_cntl_const=>gc_pak_applobj.
      ls_pnodid-pntype       = /scwm/cl_ppelipak_cntl_const=>gc_pak_workstep.
      CALL METHOD /scwm/cl_ppelipak_cntl=>pnodid_check
        EXPORTING
          im_applobj_type    = /scwm/cl_ppelipak_cntl_const=>gc_pak_applobj
          im_existence_only  = ppet_true
        CHANGING
          ch_pnodid          = ls_pnodid
        EXCEPTIONS
          no_authority       = 1
          pnodid_check_error = 2
          OTHERS             = 99.
      IF sy-subrc NE 0.
        sy-subrc = sy-subrc.
      ENDIF.
      IF ls_pnodid-pname IS NOT INITIAL.
        gv_object_key = ls_pnodid-pname.
*        CONCATENATE gv_object_key '________' INTO gv_object_key."214
      ENDIF.
    ENDIF.

    CALL METHOD z0mp_cl_dms_grid=>read_dms_links
      EXPORTING
        iv_key       = gv_object_key
        iv_cp        = 'X'  "lv_cp  214
      IMPORTING
        et_dms_links = DATA(lt_dms_links).

    LOOP AT lt_dms_links ASSIGNING FIELD-SYMBOL(<fs_link>).
      CLEAR ls_outtab.
      MOVE-CORRESPONDING <fs_link> TO ls_outtab.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
        EXPORTING
          input  = ls_outtab-document_number
        IMPORTING
          output = ls_outtab-document_number.
      APPEND ls_outtab TO gt_outtab.
    ENDLOOP.
    grid_on_data_changed_finished( e_modified = 'X' ). " 5184
  ENDMETHOD.                    "INIT_DOCUMENT_LINKS

