  METHOD  grid_on_user_command.
    DATA: lv_schan TYPE z0mp_pack_usage,
          ls_det   TYPE z0mp_s_det_ui.

    BREAK-POINT ID z0mp_all.
    BREAK-POINT ID z0mp_ps_dms.


*-->1806 OSM2KOR - Select atleast one line in order to display or delete document
    IF go_dms_grid IS BOUND AND ( e_ucomm = gc_delete OR e_ucomm = gc_display ).
      CALL METHOD go_grid->get_selected_rows
        IMPORTING
          et_index_rows = DATA(lt_row).
      IF lt_row IS INITIAL.
        MESSAGE e101(/scwm/ps_basics).
      ENDIF.
    ENDIF.
*<--1806 OSM2KOR

*-->2140 OSM2KOR
    IF e_ucomm = gc_new OR e_ucomm = gc_delete OR e_ucomm = gc_create.
      IF go_dms_grid->z0mp_if_dms_grid~g_packspec IS BOUND.
        IF go_dms_grid->z0mp_if_dms_grid~g_packspec->gv_save_err = abap_true.
          EXIT.
        ENDIF.
      ENDIF.
    ENDIF.
*<--2140 OSM2KOR

*-> PS_BREQ0504 - AGR7KOR - AA planner only can assign documents to AA DR´s
    IF go_dms_grid->z0mp_if_dms_grid~g_packspec IS BOUND.
      READ TABLE go_dms_grid->z0mp_if_dms_grid~g_packspec->gt_det
       INTO ls_det INDEX 1.
      IF sy-subrc EQ 0.
        CLEAR lv_schan.
        IF ls_det-dettype = z0mp_if_wf_drr_c=>gc_drrtype-ship OR
           ls_det-dettype = z0mp_if_wf_drr_c=>gc_drrtype-internal. "ZFER
          lv_schan = ls_det-pack_usage.
          "BEGIN OF CHANGE BY BVR3KOR USER STORY- 10608 ADD THE STOC CHECK
        ELSEIF ls_det-dettype = z0mp_if_wf_drr_c=>gc_drrtype-rcpt OR ls_det-dettype = z0mp_if_wf_drr_c=>gc_drrtype-stoc"ADDEDD STOC CHECK.
        or ls_det-dettype = z0mp_if_wf_drr_c=>gc_drrtype-pale OR ls_det-dettype = z0mp_if_wf_drr_c=>gc_drrtype-doll.""13377

          lv_schan = z0mp_if_wf_drr_c=>gc_sales_channel-oe.
        ENDIF.
      ELSE.
        MESSAGE e076(z0mp_packspec_ui) WITH lv_schan
          z0mp_if_packspec_constants=>gc_authority_sales_channel.
        RETURN.
      ENDIF.
    ENDIF.
*<- PS_BREQ0504 - AGR7KOR - AA planner only can assign documents to AA DR´s

    CASE e_ucomm.
      WHEN gc_new.
*->     PS_BREQ0504 - AGR7KOR - AA planner only can assign documents to AA DR´s
        IF sy-tcode EQ '/SCWM/PSWORKSTEP'.
          insert_new_document_link( ).
        ELSE.
          IF ( lv_schan IS NOT INITIAL OR go_dms_grid->z0mp_if_dms_grid~g_packspec IS NOT BOUND ).
            AUTHORITY-CHECK OBJECT 'Z0MP_PSSC'
              ID 'ACTVT'      FIELD z0mp_if_packspec_constants=>gc_authority_sales_channel
              ID 'SALES_CHNL' FIELD lv_schan.
            IF sy-subrc EQ 0.
              insert_new_document_link( ).
            ELSE.
              MESSAGE e042(z0mp_packspec_ui) WITH lv_schan
                z0mp_if_packspec_constants=>gc_authority_sales_channel.
            ENDIF.
          ENDIF.
        ENDIF.
*        insert_new_document_link( ).
*<-     PS_BREQ0504 - AGR7KOR - AA planner only can assign documents to AA DR´s

      WHEN gc_delete.
*->     PS_BREQ0504 - AGR7KOR - AA planner only can assign documents to AA DR´s
        IF sy-tcode EQ '/SCWM/PSWORKSTEP'.
          delete_document_link( ).
        ELSE.
          IF lv_schan IS NOT INITIAL OR go_dms_grid->z0mp_if_dms_grid~g_packspec IS NOT BOUND.
            AUTHORITY-CHECK OBJECT 'Z0MP_PSSC'
              ID 'ACTVT' FIELD z0mp_if_packspec_constants=>gc_authority_sales_channel
              ID 'SALES_CHNL' FIELD lv_schan.
            IF sy-subrc EQ 0.
              delete_document_link( ).
            ELSE.
              MESSAGE e042(z0mp_packspec_ui) WITH lv_schan
                z0mp_if_packspec_constants=>gc_authority_sales_channel.
            ENDIF.
          ENDIF.
        ENDIF.
*        delete_document_link( ).
*<-     PS_BREQ0504 - AGR7KOR - AA planner only can assign documents to AA DR´s

      WHEN gc_display.
        display_document( ).

      WHEN gc_create.
*->     PS_BREQ0504 - AGR7KOR - AA planner only can assign documents to AA DR´s
        IF sy-tcode EQ '/SCWM/PSWORKSTEP'.
          create_and_link_document( ).
        ELSE.
          IF lv_schan IS NOT INITIAL OR go_dms_grid->z0mp_if_dms_grid~g_packspec IS NOT BOUND.
            AUTHORITY-CHECK OBJECT 'Z0MP_PSSC'
              ID 'ACTVT' FIELD z0mp_if_packspec_constants=>gc_authority_sales_channel
              ID 'SALES_CHNL' FIELD lv_schan.
            IF sy-subrc EQ 0.
              create_and_link_document( ).
            ELSE.
              MESSAGE e042(z0mp_packspec_ui) WITH lv_schan
                z0mp_if_packspec_constants=>gc_authority_sales_channel.
            ENDIF.
          ENDIF.
        ENDIF.
*        create_and_link_document( ).
*<-     PS_BREQ0504 - AGR7KOR - AA planner only can assign documents to AA DR´s

    ENDCASE.

    grid_on_data_changed_finished( e_modified = 'X' ).
  ENDMETHOD.                    "grid_on_user_command
