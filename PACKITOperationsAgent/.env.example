# Splunk REST API, via the Bosch API gateway (confirmed via live Postman testing).
# Auth is a plain request header carrying the token, NOT Bearer/Basic auth. The
# header *name* is configurable so a gateway-side rename doesn't need a code
# change -- the default below is the confirmed real one.
SPLUNK_BASE_URL=https://ews-esz-emea.api.bosch.com/pdmi/splunk
SPLUNK_AUTH_HEADER=KeyID
SPLUNK_API_TOKEN=
SPLUNK_INDEX=pdbb
SPLUNK_SOURCETYPE=Native

# Don't hand-edit this file -- run `packit-agent init` instead (see README.md).
# It writes .env for you, and checks the LLM key/model actually work before
# saving. This example exists to document the shape, not to be copied.

# Which LLM backend to use: "model_farm" (Bosch-provisioned, the default), or
# a personal API key with "gemini", "openai", or "anthropic". Only the named
# provider's key is required -- the others can stay blank.
LLM_PROVIDER=model_farm

# Personal API keys -- each used only when LLM_PROVIDER names it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=20
# No default model for these two: neither vendor publishes a stable "-latest"
# alias, so `packit-agent init` fetches the live catalog instead of pinning a
# name here that would silently go stale.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=20
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_TIMEOUT_SECONDS=20

# Corporate proxy (Bosch network)
HTTP_PROXY=http://127.0.0.1:3128
HTTPS_PROXY=http://127.0.0.1:3128

SPLUNK_VERIFY_SSL=true
SPLUNK_SEARCH_TIMEOUT_SECONDS=60

# Where "Report Issue" mailto: drafts are addressed (see ARCHITECTURE.md's UI section)
ISSUE_REPORT_EMAIL=

# Additional Routing plan API -- separate from Splunk, confirmed live via the
# real Bosch gateway (see docs/components/routing-plan/TECHNICAL_SPEC.md).
# Auth is a "KeyId" header (note the casing -- different from Splunk's "KeyID"),
# with its own distinct token.
ADDITIONAL_ROUTING_URL=https://ews-esz-emea.api.bosch.com/services/P/ROUTINGPLAN
ADDITIONAL_ROUTING_AUTH_HEADER=KeyId
ADDITIONAL_ROUTING_API_TOKEN=

# Bosch Model Farm -- internal Azure-OpenAI-compatible LLM gateway (see
# modelFarm/ Docupedia export). Replaces the personal Gemini API key above;
# ModelFarmClient is the default LLMClient (see ui/cli.py).
MODEL_FARM_API_KEY=
MODEL_FARM_BASE_URL=https://aoai-farm.bosch-temp.com/api
MODEL_FARM_DEPLOYMENT=askbosch-prod-farm-openai-gpt-4o-mini-2024-07-18
MODEL_FARM_MODEL=gpt-4o-mini
MODEL_FARM_TIMEOUT_SECONDS=20
